#!/bin/sh
# Browser identity is resolved only when this command is invoked.
set -eu
LC_ALL=C
export LC_ALL

fail() { printf 'ab-worktree: %s\n' "$*" >&2; exit 2; }
usage() {
    cat <<'EOF'
Usage: ab-worktree AGENT [--instance ID] [--actor ID] [--connect-only] COMMAND [ARGS...]
       ab-worktree AGENT --instance ID --actor ID --prepare
       ab-pi [--instance ID] [--] COMMAND [ARGS...]
       ab-codex [--instance ID] [--] COMMAND [ARGS...]
ID: 1-64 ASCII letters, digits, dots, underscores or hyphens; start with a letter/digit.
AGENT: lowercase name (codex, pi, or a custom shell agent), at most 24 characters.
--prepare: host-only startup/reuse; --connect-only: requires a prepared live browser.
AWL_BROWSER_* assignments in an AWP handoff must be preserved on every call.
Legacy single-actor commands without these modes remain lazy.
EOF
}
case "${1-}" in --help|-h) usage; exit 0 ;; esac
case "${0##*/}" in
    ab-pi) agent=pi ;;
    ab-codex) agent=codex ;;
    *)
        agent=${1-}
        case "$agent" in ''|[!a-z]*|*[!a-z0-9_-]*) fail 'invalid agent name (see --help)' ;; esac
        [ "${#agent}" -le 24 ] || fail 'agent name exceeds 24 characters'
        shift
        ;;
esac
instance=${AWL_BROWSER_INSTANCE-}
actor=${AWL_BROWSER_ACTOR-}
mode=legacy
seen_instance=
seen_actor=
[ "${AWL_BROWSER_CONNECT_ONLY-}" != 1 ] || mode=connect
while [ "$#" -gt 0 ]; do
    case "$1" in
        --instance|--actor)
            option=$1
            [ "$#" -ge 2 ] || fail "$option requires an ID"
            case "$2" in ''|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) fail 'invalid instance ID or actor ID (see --help)' ;; esac
            [ "${#2}" -le 64 ] || fail 'instance ID or actor ID exceeds 64 characters'
            if [ "$option" = --instance ]; then
                [ -z "$seen_instance" ] || fail 'ambiguous repeated --instance'
                instance=$2; seen_instance=1
            else
                [ -z "$seen_actor" ] || fail 'ambiguous repeated --actor'
                actor=$2; seen_actor=1
            fi
            shift 2 ;;
        --connect-only) [ "$mode" != prepare ] || fail 'conflicting modes'; mode=connect; shift ;;
        --prepare) [ "$mode" != connect ] || fail 'host preparation forbidden in connect-only mode'; mode=prepare; shift ;;
        *) break ;;
    esac
done
# The parent must supply unique identities when actors can run concurrently.
if [ "${AWL_BROWSER_CONCURRENT-}" = 1 ] && { [ -z "$instance" ] || [ -z "$actor" ]; }; then
    fail 'concurrent browser actors require distinct stable --instance and --actor IDs from their parent'
fi
for identity in "$instance" "$actor"; do
    case "$identity" in '') ;; [!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) fail 'invalid instance ID or actor ID' ;; esac
    [ "${#identity}" -le 64 ] || fail 'instance ID or actor ID exceeds 64 characters'
done
# Assigned actors always use managed transport, even if the option was omitted.
if { [ -n "$actor" ] || [ -n "${AWL_BROWSER_INSTANCE-}" ]; } && [ "$mode" = legacy ]; then mode=connect; fi
if [ "${1-}" = -- ]; then shift; fi
[ "$mode" = prepare ] || [ "$#" -gt 0 ] || fail 'expected an agent-browser command (see --help)'
# agent-browser parses global options even after the command. Never let forwarded
# options override the identity selected here, even after --.
for argument do
    case "$argument" in
        --session|--session=*) fail '--session is owned by the helper' ;;
        --instance|--instance=*) fail '--instance must precede the browser command' ;;
    esac
done
for tool in git sha256sum; do
    command -v "$tool" >/dev/null 2>&1 || fail "required executable missing from PATH: $tool"
done
# Inherited Git selectors must not redirect identity to another checkout.
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_CEILING_DIRECTORIES GIT_DISCOVERY_ACROSS_FILESYSTEM
inside=$(git rev-parse --is-inside-work-tree 2>/dev/null) || fail 'current directory is not a Git worktree'
[ "$inside" = true ] || fail 'current directory is not inside a Git worktree'
# Append a sentinel so command substitution cannot strip newline bytes from the
# path. Remove only the command's one output newline and the sentinel afterward.
line_suffix='
.'
root=$(git rev-parse --show-toplevel 2>/dev/null && printf '.') || fail 'cannot resolve Git worktree root'
root=${root%"$line_suffix"}
[ -n "$root" ] || fail 'Git returned an empty worktree root'
root=$(CDPATH= cd -P -- "$root" && pwd -P && printf '.') || fail 'cannot resolve physical worktree root'
root=${root%"$line_suffix"}
# NUL delimiters keep optional IDs separate from paths and agent names. Use a
# bounded digest to leave room for agent-browser's Linux Unix-socket path.
digest=$(printf '%s\000%s\000%s\000' "$root" "$agent" "$instance" | sha256sum) || fail 'cannot hash worktree identity'
digest=${digest%% *}
case "$digest" in ''|*[!0-9a-f]*) fail 'invalid identity digest' ;; esac
[ "${#digest}" -eq 64 ] || fail 'invalid identity digest length'
session="awl-$agent-$(printf '%.32s' "$digest")"
if [ "$mode" != legacy ]; then
    for tool in python3 readlink; do
        command -v "$tool" >/dev/null 2>&1 || fail "required executable missing from PATH: $tool"
    done
    helper=$(readlink -f -- "$0") || fail 'cannot resolve helper installation'
    exec python3 "${helper%/*}/ab_worktree_session.py" "$root" "$agent" "$instance" "$actor" "$session" "$mode" "$@"
fi
command -v agent-browser >/dev/null 2>&1 || fail 'required executable missing from PATH: agent-browser'
agent-browser --session "$session" "$@" && exit 0
status=$?
printf 'ab-worktree: agent-browser failed for session %s (exit %s)\n' "$session" "$status" >&2
exit "$status"
